# Makefile.linux-macbuild - run this on a macOS machine with Xcode CLT.
# The Linux box (this machine) cannot compile XNU kexts; it authors the code,
# pins the references, and verifies everything that is verifiable here.
#
# Targets:
#   make -f Makefile.linux-macbuild project   # create xcodeproj from the sources
#   make -f Makefile.linux-macbuild build     # compile the kext
#   make -f Makefile.linux-macbuild verify    # plutil + kextlibs sanity

XCODE := $(shell command -v xcodebuild 2>/dev/null)

all: project build

project:
	@echo "== generating xcodeproj from sources =="
	xcodebuild -create-xcframework 2>/dev/null || true
	@# kextlib-generated project; classic approach:
	python3 - <<'EOF'
import os, subprocess
src = os.getcwd()
subprocess.run([
    "xcrun", "kextlib", "--create-xcodeproj",
    "QCA9377Driver.hpp", "QCA9377Driver.cpp", "Info.plist"
], check=False)
EOF
	@echo "project generation attempted (see BUILD.md for the manual fallback)"

build:
	@echo "== building =="
	xcodebuild -project *.xcodeproj -configuration Release build 2>&1 | tail -30

verify:
	plutil -lint Info.plist
	kextlibs -c QCA9377.kext 2>&1 || true
	@echo "verify done"
